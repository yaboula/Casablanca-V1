# ==================================
# Casablanca V1 - Frontend environment
# ==================================
# Copy this file as .env.local and fill in local values.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3600
NEXT_TELEMETRY_DISABLED=1

# --- Stripe publishable key (browser-safe) ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_YOUR_KEY

# --- API Backend (NestJS) ---
# Browser/client calls should go through the Next.js proxy.
NEXT_PUBLIC_API_URL=/api/v1

# Server-side only (Server Components, API Routes - never exposed to browser).
# The frontend API/session shell accepts API_URL first, then BACKEND_API_URL,
# then NEXT_PRIVATE_API_URL. Keep the /api/v1 suffix.
API_URL=http://localhost:3900/api/v1
# BACKEND_API_URL=http://localhost:3900/api/v1
# NEXT_PRIVATE_API_URL=http://localhost:3900/api/v1

# --- Local demo bypass ---
# Use only for local demos. Enables /api/dev/* routes and skips real payment/doc upload flows.
NEXT_PUBLIC_BYPASS_PAYMENT=false
BYPASS_PAYMENT=false

# Required only by local dev bypass routes that write directly to Postgres.
DATABASE_URL=postgresql://nexus:nexus_secret@localhost:5433/nexus_db
