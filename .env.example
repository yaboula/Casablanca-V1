# ==================================
# Casablanca V1 — Variables de Entorno
# ==================================
# Copia este archivo como .env.local y rellena los valores.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_TELEMETRY_DISABLED=1

# --- Base de Datos (a configurar en fase backend) ---
# DATABASE_URL=

# --- Stripe (pagos / señal 10€) ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REEMPLAZAR_CON_TU_CLAVE_PUBLICA
# STRIPE_SECRET_KEY= (solo backend NestJS)
# STRIPE_WEBHOOK_SECRET= (solo backend NestJS)

# --- Autenticación (a configurar) ---
# AUTH_SECRET=
# AUTH_URL=http://localhost:3000

# --- API Backend (NestJS) ---
# Desarrollo local:
NEXT_PUBLIC_API_URL=http://localhost:3900/api/v1
# Producción:
# NEXT_PUBLIC_API_URL=https://api.nexus.ma/api/v1

# Server-side only (Server Components, API Routes — never exposed to browser)
API_URL=http://localhost:3900/api/v1
# Producción: API_URL=https://api.nexus.ma/api/v1
