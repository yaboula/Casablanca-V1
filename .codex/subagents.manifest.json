      "sandbox_mode": "read-only",
      "permission_class": "read-only",
      "role": "Frontend code review and regression detection",
      "allowed_for": ["react review", "next review", "maintainability review", "accessibility review"],
      "forbidden_for": ["code changes", "fix implementation", "backend decisions", "security decisions"],
      "final_authority": false
    },
    {
      "name": "frontend_implementer_agent",
