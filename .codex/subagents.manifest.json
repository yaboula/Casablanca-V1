{
  "version": "2.0",
  "status": "active",
  "canonical_system": ".agents/system.manifest.json",
  "root_role": "PM Orchestrator",
  "root_model_policy": "GPT/OpenAI via Codex root session",
  "provider_config_location": "~/.codex/config.toml",
  "canonical_role_map": ".codex/canonical-role-map.json",
  "operational_docs": [
    ".codex/pm-operating-loop.md",
    ".codex/routing-policy.md",
    ".codex/spawn-policy.md",
    ".codex/context-budget-policy.md",
    ".codex/qa-trigger-matrix.md",
    ".codex/handoff-schema.md",
    ".codex/risk-ladder.md",
    ".codex/tool-usage-policy.md",
    ".codex/model-routing-policy.md",
    ".codex/permission-policy.md",
    ".codex/provider-setup.md"
  ],
  "subagents": [
    {
      "name": "code_mapper_agent",
      "file": ".codex/agents/code-mapper-agent.toml",
      "canonical_role": "codex-extension.code-mapper",
      "primary_model": "accounts/fireworks/models/deepseek-v4-pro",
      "secondary_model": "accounts/fireworks/models/kimi-k2p6",
      "provider": "fireworks",
      "sandbox_mode": "read-only",
      "permission_class": "read-only",
      "role": "Repository context mapping",
      "allowed_for": ["entry point discovery", "route and component mapping", "state and dependency mapping"],
      "forbidden_for": ["code changes", "ux decisions", "backend decisions", "security decisions"],
      "final_authority": false
    },
    {
      "name": "product_agent",
      "file": ".codex/agents/product-agent.toml",
      "canonical_role": "product-agent",
      "primary_model": "accounts/fireworks/models/deepseek-v4-pro",
      "secondary_model": "none",
      "provider": "fireworks",
      "sandbox_mode": "workspace-write",
      "permission_class": "docs-tickets-write",
      "role": "Product framing and task packet authoring",
      "allowed_for": ["prd drafts", "acceptance criteria", "scope slicing", "ticket drafts"],
      "forbidden_for": ["application source edits", "backend implementation", "config changes"],
      "final_authority": false
    },
    {
      "name": "ux_agent",
      "file": ".codex/agents/ux-agent.toml",
      "canonical_role": "ux-agent",
      "primary_model": "accounts/fireworks/models/deepseek-v4-pro",
      "secondary_model": "accounts/fireworks/models/kimi-k2p6",
      "provider": "fireworks",
      "sandbox_mode": "workspace-write",
      "permission_class": "docs-tickets-write",
      "role": "UX review and UX specification support",
      "allowed_for": ["ux notes", "journey analysis", "ux handoffs", "ticket drafts"],
      "forbidden_for": ["application source edits", "backend decisions", "auth decisions", "payment decisions"],
      "final_authority": false
    },
    {
      "name": "ui_design_system_agent",
      "file": ".codex/agents/ui-design-system-agent.toml",
      "canonical_role": "ui-design-system-agent",
      "primary_model": "accounts/fireworks/models/kimi-k2p6",
      "secondary_model": "accounts/fireworks/models/deepseek-v4-pro",
      "provider": "fireworks",
      "sandbox_mode": "workspace-write",
      "permission_class": "limited-write",
      "role": "Design system review and limited design-system implementation",
      "allowed_for": ["design tokens", "base ui components", "storybook files", "visual docs", "style variants"],
      "forbidden_for": ["business logic", "backend code", "auth code", "payment code", "broad redesigns without approval"],
      "final_authority": false
    },
    {
      "name": "frontend_reviewer_agent",
      "file": ".codex/agents/frontend-reviewer-agent.toml",
