      "file": ".codex/agents/backend-agent.toml",
      "canonical_role": "backend-agent",
      "primary_model": "gpt-5.4",
      "secondary_model": "none",
      "provider": "codex-root",
      "sandbox_mode": "workspace-write",
      "permission_class": "code-write",
      "role": "Backend review and implementation planning",
      "allowed_for": ["api files", "server logic", "validation logic", "backend tests", "service layer files"],
      "forbidden_for": ["database schema changes without Data Agent", "sensitive changes without Trust Agent", "package.json changes without approval"],
      "final_authority": false
    },
    {
      "name": "data_agent",
      "file": ".codex/agents/data-agent.toml",
      "canonical_role": "data-agent",
      "primary_model": "accounts/fireworks/models/deepseek-v4-pro",
      "secondary_model": "accounts/fireworks/models/kimi-k2p6",
      "provider": "fireworks",
      "sandbox_mode": "read-only",
      "permission_class": "read-only",
      "role": "Data integrity and schema review",
      "allowed_for": ["schema review", "migration review", "query review", "rollback analysis"],
      "forbidden_for": ["schema edits by default", "destructive migrations", "production data path changes"],
      "final_authority": false
    },
    {
      "name": "trust_agent",
      "file": ".codex/agents/trust-agent.toml",
      "canonical_role": "trust-agent",
      "primary_model": "accounts/fireworks/models/deepseek-v4-pro",
      "secondary_model": "none",
      "provider": "fireworks",
      "sandbox_mode": "read-only",
      "permission_class": "read-only",
      "role": "Security, privacy, and sensitive area review",
      "allowed_for": ["risk review", "auth review", "privacy review", "compliance review"],
      "forbidden_for": ["sensitive code edits", "solo approval of sensitive changes", "secret handling"],
      "final_authority": false
    },
    {
      "name": "qa_agent",
      "file": ".codex/agents/qa-agent.toml",
      "canonical_role": "qa-agent",
      "primary_model": "accounts/fireworks/models/kimi-k2p6",
      "secondary_model": "accounts/fireworks/models/deepseek-v4-pro",
      "provider": "fireworks",
      "sandbox_mode": "workspace-write",
      "permission_class": "limited-write",
      "role": "Validation, tests, and closure recommendation",
      "allowed_for": ["unit tests", "integration tests", "e2e tests", "fixtures", "qa notes"],
      "forbidden_for": ["production code changes without approval", "auth changes", "security changes", "payment changes"],
      "final_authority": false
    },
    {
      "name": "ops_agent",
      "file": ".codex/agents/ops-agent.toml",
      "canonical_role": "ops-agent",
      "primary_model": "accounts/fireworks/models/deepseek-v4-pro",
      "secondary_model": "none",
      "provider": "fireworks",
      "sandbox_mode": "read-only",
      "permission_class": "read-only",
      "role": "Ops, CI/CD, deploy, and observability review",
      "allowed_for": ["ci review", "deploy review", "docker review", "observability review"],
      "forbidden_for": ["ci edits by default", "deployment triggers", "secret writes", "tool installation"],
      "final_authority": false
    },
    {
      "name": "docs_agent",
      "file": ".codex/agents/docs-agent.toml",
      "canonical_role": "docs-agent",
      "primary_model": "accounts/fireworks/models/deepseek-v4-pro",
      "secondary_model": "accounts/fireworks/models/kimi-k2p6",
      "provider": "fireworks",
      "sandbox_mode": "workspace-write",
      "permission_class": "docs-tickets-write",
      "role": "Documentation and handoff maintenance",
      "allowed_for": ["readmes", "adrs", "api docs", "onboarding docs", "handoff summaries"],
      "forbidden_for": ["application source edits", "invented implementation status", "package.json changes"],
      "final_authority": false
    },
    {
      "name": "workflow_agent",
      "file": ".codex/agents/workflow-agent.toml",
      "canonical_role": "workflow-agent",
      "primary_model": "accounts/fireworks/models/deepseek-v4-pro",
      "secondary_model": "accounts/fireworks/models/kimi-k2p6",
      "provider": "fireworks",
      "sandbox_mode": "workspace-write",
      "permission_class": "docs-tickets-write",
      "role": "Workflow hygiene and change-control support",
      "allowed_for": ["task checklists", "ticket drafts", "workflow docs", "release checklist drafts"],
      "forbidden_for": ["application source edits", "ci changes without approval", "product scope decisions alone"],
      "final_authority": false
    }
  ],
  "global_rules": [
    "Root PM remains GPT/OpenAI",
    "Backend Agent uses GPT/OpenAI",
    "All other subagents use Kimi or DeepSeek",
    "External model agents are not final authority for sensitive changes",
    "No danger-full-access",
    "No provider secrets in repo",
    "Provider config lives in ~/.codex/config.toml",
    "PM must route through .agents canon and .codex operational policies together"
  ]
}
