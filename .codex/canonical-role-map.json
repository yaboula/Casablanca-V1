{
  "version": "1.0",
  "root_pm": {
    "native_runtime": "codex-root-session",
    "canonical_role": "pm-orchestrator",
    "canonical_file": ".agents/agents/pm-orchestrator.md"
  },
  "role_map": [
    {
      "canonical_role": "product-agent",
      "native_subagent": "product_agent",
      "canonical_file": ".agents/agents/product-agent.md"
    },
    {
      "canonical_role": "ux-agent",
      "native_subagent": "ux_agent",
      "canonical_file": ".agents/agents/ux-agent.md"
    },
    {
      "canonical_role": "ui-design-system-agent",
      "native_subagent": "ui_design_system_agent",
      "canonical_file": ".agents/agents/ui-design-system-agent.md"
    },
    {
      "canonical_role": "frontend-agent",
      "native_subagent": "frontend_reviewer_agent",
      "mode": "review",
      "canonical_file": ".agents/agents/frontend-agent.md"
    },
    {
      "canonical_role": "frontend-agent",
      "native_subagent": "frontend_implementer_agent",
      "mode": "implement",
      "canonical_file": ".agents/agents/frontend-agent.md"
    },
    {
      "canonical_role": "backend-agent",
      "native_subagent": "backend_agent",
      "canonical_file": ".agents/agents/backend-agent.md"
    },
    {
      "canonical_role": "data-agent",
      "native_subagent": "data_agent",
      "canonical_file": ".agents/agents/data-agent.md"
    },
    {
      "canonical_role": "trust-agent",
      "native_subagent": "trust_agent",
      "canonical_file": ".agents/agents/trust-agent.md"
    },
    {
      "canonical_role": "qa-agent",
      "native_subagent": "qa_agent",
      "canonical_file": ".agents/agents/qa-agent.md"
    },
    {
      "canonical_role": "ops-agent",
      "native_subagent": "ops_agent",
      "canonical_file": ".agents/agents/ops-agent.md"
    },
    {
      "canonical_role": "docs-agent",
      "native_subagent": "docs_agent",
      "canonical_file": ".agents/agents/docs-agent.md"
    },
    {
      "canonical_role": "workflow-agent",
      "native_subagent": "workflow_agent",
      "canonical_file": ".agents/agents/workflow-agent.md"
    },
    {
      "canonical_role": "codex-extension.code-mapper",
      "native_subagent": "code_mapper_agent",
      "canonical_file": ".codex/agents/code-mapper-agent.toml",
      "notes": "Codex-native extension for repository mapping before specialist dispatch."
    }
  ],
  "workflow_overrides": [
    {
      "canonical_workflow": "ui-change-workflow",
      "review_agents": [
        "code_mapper_agent",
        "ux_agent",
        "ui_design_system_agent",
        "frontend_reviewer_agent",
        "qa_agent"
      ],
      "implementation_agents": [
        "ui_design_system_agent",
        "frontend_implementer_agent",
        "qa_agent"
      ]
    },
    {
      "canonical_workflow": "backend-api-workflow",
      "review_agents": [
        "backend_agent",
        "qa_agent"
      ],
      "conditional_agents": [
        "data_agent",
        "trust_agent",
        "frontend_reviewer_agent"
      ]
    }
  ]
}
