# App
NODE_ENV=development
PORT=3900
API_PREFIX=api/v1

# PostgreSQL
# Host development uses Docker's published PostgreSQL port 5433.
DATABASE_URL=postgresql://nexus:nexus_secret@localhost:5433/nexus_db
DATABASE_SSL=false

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=changeme_min_64_chars_use_openssl_rand_hex_32_in_production_please
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=changeme_refresh_secret_min_32_chars_different_from_jwt_secret
JWT_REFRESH_EXPIRES_IN=30d

# Stripe
STRIPE_SECRET_KEY=sk_test_replace_with_real_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_real_secret
STRIPE_DEPOSIT_EUR=10

# AWS S3
AWS_ACCESS_KEY_ID=replace_with_real_key
AWS_SECRET_ACCESS_KEY=replace_with_real_secret
AWS_REGION=eu-west-3
AWS_S3_BUCKET=nexus-documents
AWS_S3_PRESIGN_EXPIRES_SECONDS=900

# QR Signing
QR_SIGNING_SECRET=changeme_qr_signing_secret_min_32_chars

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:3600

# Operator
OPERATOR_WHATSAPP=212600000000
