# Backend environment for full-stack E2E/smoke testing
NODE_ENV=test
PORT=3902
API_PREFIX=api/v1

DATABASE_URL=postgresql://nexus:nexus_secret@localhost:5433/nexus_e2e_db
DATABASE_SSL=false

REDIS_URL=redis://localhost:6379
BYPASS_S3=true

# Use the same JWT secret as dev (so tokens from dev Stripe tests still work)
JWT_SECRET=changeme_min_64_chars_use_openssl_rand_hex_32_in_production_please
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=nexus_refresh_secret_changeme_min32_PRODUCTION_use_openssl
JWT_REFRESH_EXPIRES_IN=30d

# Stripe stays configured, but the local smoke flow uses explicit frontend demo bypass
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_REAL_TEST_KEY
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_YOUR_REAL_WEBHOOK_SECRET
STRIPE_DEPOSIT_EUR=10

# AWS S3 — placeholders are fine because BYPASS_S3=true for local smoke
AWS_ACCESS_KEY_ID=e2e_placeholder_key
AWS_SECRET_ACCESS_KEY=e2e_placeholder_secret
AWS_REGION=eu-west-3
AWS_S3_BUCKET=nexus-documents-e2e
AWS_S3_PRESIGN_EXPIRES_SECONDS=900

# QR Signing
QR_SIGNING_SECRET=changeme_qr_signing_secret_min_32_chars_e2e

# Operator
OPERATOR_WHATSAPP=212600000000

# Frontend (for CORS / email links)
FRONTEND_URL=http://localhost:3600
