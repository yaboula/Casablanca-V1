# ================================================================
# NEXUS — Test Environment Variables
# Used ONLY by integration tests (Level 2).
# Never commit real secrets here — all values are test stubs.
# ================================================================

# App
NODE_ENV=test
PORT=3002
API_PREFIX=api/v1

# ── PostgreSQL (test database — isolated from development DB) ──
DATABASE_URL=postgresql://nexus:nexus_secret@localhost:5433/nexus_test_db
DATABASE_SSL=false

# ── Redis (same instance, different logical DB via BullMQ — mocked in tests) ──
REDIS_URL=redis://localhost:6379

# ── JWT (valid lengths, test-only secrets) ──────────────────────
JWT_SECRET=test_jwt_secret_minimum_32_chars_abcdef
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=test_refresh_secret_minimum_32_chars_xyz
JWT_REFRESH_EXPIRES_IN=30d

# ── Stripe (mocked in integration tests — never hits real API) ──
STRIPE_SECRET_KEY=sk_test_integration_placeholder_00000000000
STRIPE_WEBHOOK_SECRET=whsec_test_integration_placeholder_000000
STRIPE_DEPOSIT_EUR=10

# ── AWS S3 (mocked in integration tests) ────────────────────────
AWS_ACCESS_KEY_ID=AKIATEST00000000TESTKEY
AWS_SECRET_ACCESS_KEY=test_aws_secret_access_key_placeholder_00
AWS_REGION=eu-west-3
AWS_S3_BUCKET=nexus-test-bucket
AWS_S3_PRESIGN_EXPIRES_SECONDS=900

# ── QR (must be 32+ chars) ──────────────────────────────────────
QR_SIGNING_SECRET=test_qr_signing_secret_minimum_32_chars!!

# ── CORS ────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Operator ────────────────────────────────────────────────────
OPERATOR_WHATSAPP=+34600000000
