{
  "name": "nexus-backend",
  "version": "1.0.0",
  "description": "NEXUS - Premium Car Rental Platform Backend API",
  "author": "NEXUS Engineering",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "node -e \"const fs=require('fs');fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('tsconfig.tsbuildinfo',{force:true});\"",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "start:e2e": "npm run build && npm run preflight:e2e && npm run start:e2e:node",
    "start:e2e:node": "cross-env DOTENV_CONFIG_PATH=.env.e2e.backend node -r dotenv/config dist/main.js",
    "start:e2e:watch": "cross-env DOTENV_CONFIG_PATH=.env.e2e.backend nest start --watch",
    "preflight:e2e": "cross-env DOTENV_CONFIG_PATH=.env.e2e.backend node -r dotenv/config scripts/preflight-e2e.js",
    "docker:dev": "docker compose -f docker/docker-compose.yml up -d postgres redis",
    "db:test:setup": "node scripts/setup-test-dbs.js",
    "db:e2e:migrate": "cross-env DATABASE_URL=postgresql://nexus:nexus_secret@localhost:5433/nexus_e2e_db typeorm-ts-node-commonjs migration:run -d src/config/data-source.ts",
    "db:e2e:seed": "npm run seed:e2e:users && npm run seed:e2e:vehicles",
    "db:e2e:prepare": "npm run db:test:setup && npm run db:e2e:migrate && npm run db:e2e:seed",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "pretest:integration": "npm run db:test:setup",
    "test:integration": "jest --config ./test/jest-integration.json --runInBand --forceExit",
    "test:integration:watch": "jest --config ./test/jest-integration.json --runInBand --watch",
    "test:all": "npm run test -- --forceExit && npm run test:integration",
    "pretest:e2e": "npm run db:test:setup",
    "test:e2e": "npm run test:integration",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/config/data-source.ts",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/config/data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/config/data-source.ts",
    "migration:show": "typeorm-ts-node-commonjs migration:show -d src/config/data-source.ts",
    "seed:vehicles": "ts-node src/database/seeds/vehicles.seed.ts",
    "seed:users": "ts-node src/database/seeds/users.seed.ts",
    "seed:e2e:users": "cross-env DOTENV_CONFIG_PATH=.env.e2e.backend ts-node -r dotenv/config src/database/seeds/users.seed.ts",
    "seed:e2e:vehicles": "cross-env DOTENV_CONFIG_PATH=.env.e2e.backend ts-node -r dotenv/config src/database/seeds/vehicles.seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.554.0",
    "@aws-sdk/s3-request-presigner": "^3.554.0",
    "@nestjs/bullmq": "^10.2.0",
    "@nestjs/cache-manager": "^2.3.0",
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/swagger": "^7.3.0",
    "@nestjs/throttler": "^5.1.1",
    "@nestjs/typeorm": "^10.0.2",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.7.0",
    "cache-manager": "^5.7.6",
    "cache-manager-ioredis-yet": "^2.1.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.11.3",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "stripe": "^14.17.0",
    "typeorm": "^0.3.19",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.2",
    "@nestjs/schematics": "^10.1.1",
    "@nestjs/testing": "^10.3.0",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.5",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "cross-env": "^10.1.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.4",
    "ts-node": "^10.9.2",
    "typeorm-ts-node-commonjs": "^0.3.19",
    "typescript": "^5.3.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s",
      "!**/*.module.ts",
      "!**/main.ts",
      "!**/data-source.ts"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "coverageThreshold": {
      "global": {
        "branches": 75,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  }
}
