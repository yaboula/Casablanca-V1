# ============================================================
# E2E Test Environment — Level 3 Playwright
# ============================================================
# This file is loaded by playwright.config.ts before tests run.
# Never commit real secrets — use placeholder values here.
# Replace values marked <REPLACE> with your actual test credentials.

# Direct pg connection for db.fixture.ts (truncate between tests)
# Must point to the same DB the backend is using during E2E runs
E2E_DATABASE_URL=postgresql://nexus:nexus_secret@localhost:5433/nexus_e2e_db

# Backend base URL (for auth.fixture.ts — direct API calls to register/login)
# Playwright starts the backend on this URL automatically.
E2E_API_URL=http://localhost:3902/api/v1

# Stripe publishable key placeholder. The local smoke flow uses explicit demo bypass.
E2E_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_YOUR_TEST_KEY

# Optional: seed an OPERATOR user (if you want to test the operator panel)
# E2E_OPERATOR_EMAIL=operator@nexus-e2e.com
# E2E_OPERATOR_PASSWORD=OperatorPass123!
